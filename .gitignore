# Python/test cache
__pycache__/
*.pyc
.pytest_cache/

# Generated packages and local agent scratch
/exports/
/.arena/

# Local application secrets/configuration
/.env
/.env.*
!/.env.example
/config.php
/food-ticket-env.php

# Runtime data and user uploads must never be committed
/storage/*
!/storage/.htaccess
!/storage/sessions/
/storage/sessions/*
!/storage/sessions/.htaccess
/uploads/

# Tool/dependency build output
/node_modules/
/vendor/
