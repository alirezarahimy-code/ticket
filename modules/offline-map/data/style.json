{
  "version": 8,
  "name": "Iran National Offline GIS",
  "metadata": {
    "map:license": "OpenStreetMap ODbL-1.0",
    "map:attribution": "© OpenStreetMap contributors",
    "map:max-data-zoom": 17
  },
  "glyphs": "./fonts/{fontstack}/{range}.pbf",
  "sources": {
    "iran": {
      "type": "vector",
      "url": "pmtiles://./iran.pmtiles",
      "attribution": "© OpenStreetMap contributors",
      "minzoom": 0,
      "maxzoom": 17
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2f0e8"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "iran",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "forest",
          "#d9e7d1",
          "park",
          "#d8e9d1",
          "garden",
          "#dcebd7",
          "residential",
          "#eeeae1",
          "industrial",
          "#e9e5df",
          "commercial",
          "#eee8df",
          "farmland",
          "#e8ebd9",
          "#e8eadf"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "iran",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9cfe0"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "iran",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9cfe0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          13,
          2.5,
          17,
          4
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "iran",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#d8d2c8",
        "fill-outline-color": "#c6beb2",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "admin-boundaries",
      "type": "line",
      "source": "iran",
      "source-layer": "admin_boundaries",
      "paint": {
        "line-color": "#a58e82",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.5,
          8,
          1.2,
          12,
          1.8,
          17,
          2.5
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link",
            "primary",
            "primary_link"
          ]
        ]
      ],
      "paint": {
        "line-color": "#d1c2a7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          1,
          12,
          5,
          17,
          13
        ]
      }
    },
    {
      "id": "roads-main",
      "type": "line",
      "source": "iran",
      "source-layer": "roads",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "motorway",
          "#e8a65a",
          "motorway_link",
          "#e8a65a",
          "trunk",
          "#e8b86d",
          "trunk_link",
          "#e8b86d",
          "primary",
          "#f4d28b",
          "primary_link",
          "#f4d28b",
          "secondary",
          "#fff5dc",
          "tertiary",
          "#fffdf5",
          "residential",
          "#fffdf8",
          "living_street",
          "#fffdf8",
          "service",
          "#fffdf8",
          "footway",
          "#f6f2e9",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          11,
          1.4,
          14,
          3,
          17,
          8
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "roads",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_fa"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          9,
          17,
          13
        ],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#5d554d",
        "text-halo-color": "#fffdf8",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "iran",
      "source-layer": "railways",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#8a6b9d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.8,
          14,
          3,
          17,
          4
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "iran",
      "source-layer": "places",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_fa"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name_en"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          10,
          15,
          15,
          19
        ],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#464c47",
        "text-halo-color": "#f7f5ef",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-circles",
      "type": "circle",
      "source": "iran",
      "source-layer": "poi",
      "minzoom": 14,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          2,
          18,
          5
        ],
        "circle-color": "#b45f52",
        "circle-stroke-color": "#fff",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "poi",
      "minzoom": 16,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name_fa"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": 11,
        "text-offset": [
          0,
          1.1
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#684b43",
        "text-halo-color": "#fffdf8",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "addresses",
      "type": "symbol",
      "source": "iran",
      "source-layer": "addresses",
      "minzoom": 17,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "house_number"
          ],
          [
            "get",
            "name_fa"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#5a5148",
        "text-halo-color": "#fff",
        "text-halo-width": 1
      }
    },
    {
      "id": "transit-points",
      "type": "circle",
      "source": "iran",
      "source-layer": "transit",
      "paint": {
        "circle-color": "#7b4ca0",
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          2,
          17,
          6
        ],
        "circle-stroke-color": "#fff",
        "circle-stroke-width": 1.5
      }
    }
  ]
}
