{
  "version": 8,
  "name": "Iran Offline Basemap",
  "metadata": {
    "map:license": "OpenStreetMap ODbL-1.0",
    "map:attribution": "© OpenStreetMap contributors"
  },
  "glyphs": "./fonts/{fontstack}/{range}.pbf",
  "sources": {
    "iran": {
      "type": "vector",
      "url": "pmtiles://./iran.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f1f0e9"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "iran",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#dce8d5",
          "grass",
          "#e5ecd9",
          "scrub",
          "#e9ecd9",
          "#e7ebdf"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "iran",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "park",
          "#d8e9d1",
          "garden",
          "#dcebd7",
          "residential",
          "#eeeae1",
          "industrial",
          "#e9e5df",
          "commercial",
          "#eee8df",
          "#e8eadf"
        ],
        "fill-opacity": 0.65
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "iran",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a9cfe0"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "iran",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9cfe0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          13,
          2.5
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "iran",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d8d2c8",
        "fill-outline-color": "#c6beb2",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "boundary-admin",
      "type": "line",
      "source": "iran",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#a58e82",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.5,
          8,
          1.2,
          12,
          1.8
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "iran",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#d1c2a7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          1,
          12,
          5,
          18,
          12
        ]
      }
    },
    {
      "id": "roads-main",
      "type": "line",
      "source": "iran",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "motorway",
          "#e8a65a",
          "trunk",
          "#e8b86d",
          "primary",
          "#f4d28b",
          "secondary",
          "#fffdf5",
          "tertiary",
          "#fffdf8",
          "minor",
          "#fffdf8",
          "service",
          "#fffdf8",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.4,
          12,
          2,
          17,
          7
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fa"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          9,
          17,
          13
        ],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#5d554d",
        "text-halo-color": "#fffdf8",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fa"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          10,
          15,
          15,
          19
        ],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#464c47",
        "text-halo-color": "#f7f5ef",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-circles",
      "type": "circle",
      "source": "iran",
      "source-layer": "poi",
      "minzoom": 13,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2,
          18,
          5
        ],
        "circle-color": "#b45f52",
        "circle-stroke-color": "#fff",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "iran",
      "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fa"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "name:en"
          ]
        ],
        "text-font": [
          "Noto Sans Arabic Regular"
        ],
        "text-size": 11,
        "text-offset": [
          0,
          1.1
        ],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#684b43",
        "text-halo-color": "#fffdf8",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "transport-rail",
      "type": "line",
      "source": "iran",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#8a6b9d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.8,
          14,
          3
        ],
        "line-dasharray": [
          2,
          1
        ]
      }
    }
  ]
}
